<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Arabic overrides only. Numeric styles (DisplayNumeric, ValueNumeric,
         LabelNumeric) are intentionally absent, so they keep Doto. -->

    <style name="Label">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">@font/alexandria_semibold</item>
        <item name="android:textColor">@color/fg_dim</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="LabelFaint" parent="Label">
        <item name="android:textColor">@color/fg_faint</item>
    </style>

    <style name="LabelStrong" parent="Label">
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="Value">
        <item name="android:textSize">@dimen/text_value</item>
        <item name="android:fontFamily">@font/alexandria_regular</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Display">
        <item name="android:fontFamily">@font/alexandria_semibold</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="PrayerName">
        <item name="android:fontFamily">@font/alexandria_semibold</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SettingsTitle">
        <item name="android:fontFamily">@font/alexandria_semibold</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ButtonPill">
        <item name="android:background">@drawable/bg_pill_white</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">@font/alexandria_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="ButtonGhost" parent="ButtonPill">
        <item name="android:background">@drawable/bg_pill_outline</item>
        <item name="android:textColor">@color/fg</item>
    </style>

</resources>
