<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night palette: the original pure-black Nothing look. -->
    <color name="bg">#FF000000</color>
    <color name="surface">#FF0A0A0A</color>
    <color name="surface_high">#FF121212</color>
    <color name="surface_press">#FF1A1A1A</color>
    <color name="line">#FF1F1F1F</color>
    <color name="line_soft">#FF141414</color>
    <color name="fg">#FFF4F4F2</color>
    <color name="fg_dim">#FF8E8E8E</color>
    <!-- Quiet ink stays readable on both black and the #121212 cards:
         #7E7E7E is 5.17:1 on black and 4.61:1 on #121212. -->
    <color name="fg_faint">#FF7E7E7E</color>
    <color name="fg_past">#FF7E7E7E</color>
    <color name="accent">#FFD71921</color>
    <!-- The deep red is right for dots and rails, but small accent text on
         #121212 needs a lighter tint to clear 4.5:1. -->
    <color name="accent_text">#FFF4333B</color>
    <color name="accent_dim">#FF7A1219</color>
    <color name="accent_soft">#26D71921</color>
    <color name="icon_bg">#FF000000</color>
    <color name="ripple">#26FFFFFF</color>
    <color name="ripple_inverse">#33000000</color>
    <color name="dialog_bg">#FF090909</color>
    <color name="dialog_line">#FF232323</color>
    <color name="dot_field">#FFFFFFFF</color>
    <color name="arc">#FFFFFFFF</color>
    <color name="track">#FF262626</color>
    <color name="transparent">#00000000</color>
