<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.dotpray.app.ui.DotFieldView
        android:id="@+id/dotField"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingEnd="22dp"
            android:paddingBottom="40dp">

            <!-- ── brand + current time ─────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:letterSpacing="0.05"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/brand_wordmark"
                        android:textDirection="ltr"
                        android:textSize="26sp"
                        style="@style/DisplayBlack" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/tagline"
                        android:textAlignment="viewStart"
                        style="@style/LabelFaint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/now_label"
                        style="@style/LabelFaint" />

                    <TextView
                        android:id="@+id/clockValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="end"
                        android:maxLines="1"
                        android:maxWidth="140dp"
                        android:text="@string/sample_clock"
                        android:textSize="12sp"
                        style="@style/ValueNumeric" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── location + date ───────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical">

                    <!-- The chip stays visually 28 dp tall, but the frame
                         gives it a full 48 dp touch target. -->
                    <FrameLayout
                        android:id="@+id/cityTouch"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp">

                        <LinearLayout
                            android:id="@+id/cityButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:background="@drawable/bg_pill_outline"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="8dp"
                            android:stateListAnimator="@null">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot" />

                            <TextView
                                android:id="@+id/cityLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:text="@string/sample_city"
                                style="@style/LabelStrong" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="@dimen/text_date_max"
                        android:autoSizeMinTextSize="@dimen/text_date_min"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="190dp"
                        android:singleLine="true"
                        android:gravity="end"
                        android:text="@string/sample_date"
                        style="@style/Label" />

                    <TextView
                        android:id="@+id/hijriLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:autoSizeMaxTextSize="@dimen/text_hijri_max"
                        android:autoSizeMinTextSize="@dimen/text_hijri_min"
                        android:autoSizeStepGranularity="0.5sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="190dp"
                        android:singleLine="true"
                        android:gravity="end"
                        android:text="@string/sample_hijri"
                        style="@style/LabelFaint" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/locationDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/sample_detail"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                style="@style/LabelFaint" />

            <!-- ── next prayer ───────────────────────────────────────── -->
            <FrameLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.dotpray.app.ui.PulseDotView
                            android:layout_width="10dp"
                            android:layout_height="10dp" />

                        <TextView
                            android:id="@+id/nextHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:text="@string/next_prayer"
                            style="@style/Label" />

                        <TextView
                            android:id="@+id/heroIndex"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/sample_index"
                            android:textColor="@color/fg_dim"
                            style="@style/LabelNumeric" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nextName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/sample_prayer"
                        android:textSize="@dimen/text_prayer_hero"
                        style="@style/PrayerName" />

                    <TextView
                        android:id="@+id/nextTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:autoSizeMaxTextSize="60sp"
                        android:autoSizeMinTextSize="32sp"
                        android:autoSizeStepGranularity="2sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:letterSpacing="0"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/sample_time"
                        android:textSize="60sp"
                        style="@style/DisplayNumeric" />

                    <TextView
                        android:id="@+id/graceMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/fg"
                        android:textSize="@dimen/text_grace"
                        android:visibility="gone"
                        style="@style/Value" />

                    <LinearLayout
                        android:id="@+id/countdownRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/in_label"
                            android:textColor="@color/accent_text"
                            style="@style/Label" />

                        <TextView
                            android:id="@+id/countdownValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/sample_countdown"
                            android:textColor="@color/fg"
                            android:textSize="22sp"
                            style="@style/ValueNumeric" />
                    </LinearLayout>

                    <com.dotpray.app.ui.ProgressLineView
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/sinceLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/sample_since"
                            style="@style/Label" />

                        <TextView
                            android:id="@+id/progressLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/sample_progress"
                            style="@style/Label" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ── today ─────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/today"
                    style="@style/LabelStrong" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@color/line" />

                <TextView
                    android:id="@+id/clockTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clock_24h_tag"
                    style="@style/LabelFaint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- ── location ──────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/tileLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="0dp"
                android:background="@drawable/bg_tile"
                android:clipToPadding="true"
                android:gravity="start"
                android:orientation="vertical"
                android:padding="16dp"
                android:stateListAnimator="@null">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/current_location_label"
                    android:textAlignment="viewStart"
                    android:textDirection="anyRtl"
                    style="@style/Label" />

                <TextView
                    android:id="@+id/locationValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:autoSizeMaxTextSize="@dimen/text_location"
                    android:autoSizeMinTextSize="@dimen/text_location_min"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="2"
                    android:text="@string/sample_location"
                    android:textAlignment="viewStart"
                    android:textDirection="firstStrong"
                    android:textSize="@dimen/text_location"
                    style="@style/Value" />

                <TextView
                    android:id="@+id/locationCoords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/sample_coords"
                    android:textAlignment="viewStart"
                    android:textDirection="ltr"
                    style="@style/Label" />

                <TextView
                    android:id="@+id/locationHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/location_hint_gps"
                    android:textAlignment="viewStart"
                    android:textColor="@color/fg"
                    android:textDirection="anyRtl"
                    style="@style/Label" />
            </LinearLayout>

            <!-- ── qibla ─────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/tileQibla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_qibla" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/qibla"
                        android:textAlignment="viewStart"
                        style="@style/LabelStrong" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="@string/qibla_open_compass"
                        android:textAlignment="viewStart"
                        style="@style/LabelFaint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/qiblaTileValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:letterSpacing="0.04"
                    android:text="@string/sample_qibla_bearing"
                    android:textDirection="ltr"
                    android:textSize="14sp"
                    style="@style/DisplayNumeric" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:autoMirrored="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/fg_dim" />
            </LinearLayout>

            <!-- ── actions ────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAddWidget"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="58"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:text="@string/add_widget"
                    style="@style/ButtonPill" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="52dp" />

                <TextView
                    android:id="@+id/btnSettingsGhost"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="42"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:text="@string/settings"
                    style="@style/ButtonGhost" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/footer"
                style="@style/LabelFaint" />

            <TextView
                android:id="@+id/versionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/version_label"
                style="@style/LabelFaint" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
