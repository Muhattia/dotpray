<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_option"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="13dp"
    android:paddingEnd="16dp"
    android:paddingBottom="13dp">

    <View
        android:id="@+id/pMarker"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_dot"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/pIndex"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:text="@string/sample_index"
        style="@style/LabelNumeric" />

    <TextView
        android:id="@+id/pName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/sample_prayer"
        android:textSize="@dimen/text_prayer_row"
        style="@style/PrayerName" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/sample_time"
            android:textSize="24sp"
            style="@style/DisplayNumeric" />

        <TextView
            android:id="@+id/pStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:text="@string/status_next"
            android:textColor="@color/accent_text"
            android:textSize="@dimen/text_status"
            android:visibility="invisible"
            style="@style/Label" />
    </LinearLayout>
</LinearLayout>
