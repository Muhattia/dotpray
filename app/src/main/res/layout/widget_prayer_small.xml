<?xml version="1.0" encoding="utf-8"?>
<!--
  The card artwork is drawn by WidgetRenderer into a bitmap: RemoteViews cannot
  carry the Doto Typeface, so laying the whole widget out with TextViews would
  lose the dot-matrix look.  The compact composition is one centred stack: prayer
  name, scheduled time, then countdown.  The card shows minutes only and is
  repainted on the minute boundary.  The compact card has no wall clock.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <!-- No placeholder src: the renderer always paints into wCanvas, and a
         placeholder would flash a filled card over a transparent widget. -->
    <ImageView
        android:id="@+id/wCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

</FrameLayout>
