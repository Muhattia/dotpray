<?xml version="1.0" encoding="utf-8"?>
<!--
  The card artwork is drawn by WidgetRenderer into a bitmap: RemoteViews cannot
  carry the Doto Typeface, so laying the whole widget out with TextViews would
  lose the dot-matrix look.  The moving seconds are Doto glyph-pair vectors in
  one-second ViewFlippers: the launcher advances them itself, without waking
  the app process.  A single 60-child flipper per field (rather than separate
  tens and units) keeps the count in phase and wraps 59 -> 00 correctly.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitXY"
        android:src="@drawable/widget_preview_small" />

