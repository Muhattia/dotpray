<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Dotpray" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/fg_dim</item>
        <item name="android:textColorHint">@color/fg_faint</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- We ship our own values-night palette; never let the platform
             force-darken the light theme when the phone is in dark mode. -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:fontFamily">@font/doto_regular</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- A real floating dialog theme: the activity animation and opaque
         window background are what made the settings sheet pop/reflow. -->
    <style name="Theme.Dotpray.Dialog" parent="@android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.75</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:fontFamily">@font/doto_regular</item>
    </style>

    <style name="Label">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:textColor">@color/fg_dim</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="LabelFaint" parent="Label">
        <item name="android:textColor">@color/fg_faint</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="LabelStrong" parent="Label">
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="Value">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/doto_regular</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Display">
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="DisplayBlack">
        <item name="android:fontFamily">@font/doto_black</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ButtonPill">
        <item name="android:background">@drawable/bg_pill_white</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/doto_bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="ButtonGhost" parent="ButtonPill">
        <item name="android:background">@drawable/bg_pill_outline</item>
        <item name="android:textColor">@color/fg</item>
    </style>

</resources>
